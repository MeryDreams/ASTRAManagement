<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astra_black"
    tools:context=".BuscarArtista">

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        android:padding="28dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar artista"
            android:textColor="@color/astra_white"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            style="@style/AstraLabel"
            android:labelFor="@id/spTipoSede"
            android:text="TIPO"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spTipoSede"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="@color/astra_light_purple"
            android:background="@drawable/bg_tarjeta"/>

        <TextView
            style="@style/AstraLabel"
            android:labelFor="@id/spArtista"
            android:text="ARTISTA"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/spArtista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="@color/astra_light_purple"
            android:textColor="@color/astra_white"
            android:background="@drawable/bg_tarjeta" />

        <TextView
            style="@style/AstraLabel"
            android:text="SEDE"
            android:layout_marginBottom="5dp"/>

        <ListView
            android:id="@+id/lvSede"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:backgroundTint="@color/astra_light_purple"
            android:textColor="@color/astra_white"
            android:background="@drawable/bg_tarjeta"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="VER RESUMEN"
            android:textStyle="bold"
            android:backgroundTint="@color/astra_purple"
            android:textColor="@color/astra_black"/>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>