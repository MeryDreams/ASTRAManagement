<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astra_black"
    tools:context=".login.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- LOGOTIPO -->

        <TextView

            android:id="@+id/tvNombreEmpresa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASTRA"
            android:textColor="@color/astra_white"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@+id/tvEmpresa"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/tvEmpresa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:text="E N T E R T A I N M E N T"
            android:textColor="@color/astra_blue"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/tvSistema"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/tvSistema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="56dp"
            android:text="MANAGEMENT SYSTEM"
            android:textColor="@color/astra_gray"
            android:textSize="10sp"
            app:layout_constraintBottom_toTopOf="@+id/tvBienvenida"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- BIENVENIDA -->

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textColor="@color/astra_white"
            android:textSize="29sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvDescripcion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.024"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Accede a tu espacio de trabajo"
            android:textColor="@color/astra_gray"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/tvCorreo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.024"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- CORREO -->

        <TextView
            android:id="@+id/tvCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="CORREO ELECTRÓNICO"
            android:textColor="@color/astra_light_purple"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/etCorreo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.019"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="353dp"
            android:layout_height="49dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/astra_blue"
            android:ems="10"
            android:hint="employee@astra.com"
            android:inputType="textEmailAddress"
            android:textColor="@color/astra_white"
            android:textColorHint="@color/astra_dark_gray"
            app:layout_constraintBottom_toTopOf="@+id/tvContrasena"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.428"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="CONTRASEÑA"
            android:textColor="@color/astra_light_purple"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/etContrasena"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="354dp"
            android:layout_height="50dp"
            android:layout_marginBottom="60dp"
            android:backgroundTint="@color/astra_blue"
            android:ems="10"
            android:hint="Introduce tu contraseña"
            android:inputType="textPassword"
            android:textColor="@color/astra_white"
            android:textColorHint="@color/astra_dark_gray"
            app:layout_constraintBottom_toTopOf="@+id/btnAcceder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnAcceder"
            android:layout_width="353dp"
            android:layout_height="48dp"
            android:layout_marginBottom="68dp"
            android:backgroundTint="@color/astra_blue"
            android:text="SIGN IN"
            android:textColor="@color/astra_black"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvPrivacidad"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvPrivacidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTHORIZED PERSONNEL ONLY"
            android:textColor="@color/astra_dark_gray"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="parent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>